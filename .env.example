# Server-side only. Never prefix the API key with NEXT_PUBLIC_.
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=replace-in-local-env-only
LLM_MODEL=replace-with-model-id
LLM_TIMEOUT_MS=20000

# Conversation history storage. All credentials below are server-side only.
CONVERSATION_STORE=supabase
SUPABASE_URL=
# Choose one: prefer SUPABASE_SECRET_KEY for new projects, or use the legacy
# SUPABASE_SERVICE_ROLE_KEY. Never prefix either variable with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
BLOB_READ_WRITE_TOKEN=
LOCAL_HISTORY_DIR=.data/chat-history
